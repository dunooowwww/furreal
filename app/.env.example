# Salin ke .env.local lalu isi. Dipakai lewat:
#   flutter run --dart-define-from-file=.env.local
# Hanya nilai yang BOLEH ada di app. Jangan taruh service role key di sini.
# Nilai lokal: jalankan `supabase status` setelah `supabase start`.
# Emulator Android mengakses host lewat 10.0.2.2, bukan 127.0.0.1.
SUPABASE_URL=http://10.0.2.2:54321
SUPABASE_ANON_KEY=
