<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12+: jangan bawa data app (sesi login Supabase, cache) lewat backup
     cloud atau pindah HP. Setelah pasang ulang / HP baru, user masuk lagi. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </device-transfer>
</data-extraction-rules>
