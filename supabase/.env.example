# Secrets Edge Function. Salin ke supabase/.env lalu jalankan:
#   npx supabase functions serve --env-file supabase/.env
# Untuk produksi: `npx supabase secrets set NAMA=nilai`. Jangan pernah commit nilai asli.
# SUPABASE_URL dan SUPABASE_SERVICE_ROLE_KEY otomatis tersedia di Edge Function.

# --- AI (identify-animal) ---------------------------------------------------
# mock (default, tanpa API) | anthropic | openai_compatible
AI_PROVIDER=mock

# anthropic: AI_MODEL default claude-haiku-5-5, AI_BASE_URL default https://api.anthropic.com
# openai_compatible (mis. Sumopod): AI_BASE_URL (biasanya diakhiri /v1) dan AI_MODEL wajib,
#   dan modelnya harus menerima input gambar.
AI_BASE_URL=
AI_MODEL=
AI_API_KEY=

# --- Notifikasi (M6) --------------------------------------------------------
FCM_SERVICE_ACCOUNT_JSON=
