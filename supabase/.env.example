# Secrets Edge Function. Salin ke supabase/.env untuk `supabase functions serve --env-file supabase/.env`.
# Untuk produksi: `supabase secrets set NAMA=nilai`. Jangan pernah commit nilai asli.
# SUPABASE_URL dan SUPABASE_SERVICE_ROLE_KEY otomatis tersedia di Edge Function.
ANTHROPIC_API_KEY=
FCM_SERVICE_ACCOUNT_JSON=
